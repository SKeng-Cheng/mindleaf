      ],
      "color": "#fecdd3"
    },
    {
      "id": "n_wdh81m",
      "parent": "n_yk8wlv",
      "text": "库存服务独立部署",
      "note": "",
      "order": 1,
      "collapsed": false,
      "links": [],
      "color": "#fecdd3"
    },
    {
      "id": "n_xovwr0",
      "parent": "n_yk8wlv",
      "text": "灰度：先切 10% 流量",
      "note": "",
      "order": 2,
      "collapsed": false,
      "links": [],
      "color": "#fecdd3"
    },
    {
      "id": "n_u41axv",
