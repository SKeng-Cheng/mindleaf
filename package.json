{
  "name": "mindleaf",
  "version": "0.2.0",
  "description": "A local, file-first mind map that humans edit in the browser and AI agents edit over MCP. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "SKeng-Cheng",
  "bin": {
    "mindleaf": "bin/mindleaf.mjs",
    "mm": "bin/mindleaf.mjs"
  },
  "exports": {
    ".": "./src/core/index.mjs",
    "./core": "./src/core/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "web",
    "templates",
    "examples",
    "integrations/install.mjs",
    "integrations/dsh",
    "README.md",
    "MANUAL.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/mindleaf.mjs serve",
    "mm": "node bin/mindleaf.mjs",
    "lite": "node scripts/build-lite.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mindmap",
    "mcp",
    "markdown",
    "markmap",
    "mermaid",
    "ai",
    "llm",
    "agent",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKeng-Cheng/mindleaf.git"
  },
  "homepage": "https://github.com/SKeng-Cheng/mindleaf#readme"
}
